# Copy to .env in the repository root. Never commit your .env.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the public anon JWT or sb_publishable_ key, NEVER service_role / sb_secret_.

# Server-side language-model endpoints (Groq OpenAI-compatible API)
GROQ_API_KEY=
# Optional model overrides. Defaults: openai/gpt-oss-120b, fallback openai/gpt-oss-20b.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
