# Copy to .env in the repository root. Never commit your .env.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the public anon JWT or sb_publishable_ key, NEVER service_role / sb_secret_.
# Required by every server-side AI feature (AI Coach, Writing/Speaking
# grading, the quiz generator, the 1-Click mock generator and the listening
# audio fallback). Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin the Groq text model (default: llama-3.3-70b-versatile, which
# Groq retired for free/developer keys on 2026-08-16 — lib/aiClient.js then
# falls back to openai/gpt-oss-120b automatically).
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: Orpheus voice for generated listening audio
# (autumn, diana, hannah, austin, daniel, troy).
# GROQ_TTS_VOICE=troy
