# Copy to .env in the repository root. Never commit your .env.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the public anon JWT or sb_publishable_ key, NEVER service_role / sb_secret_.
# Optional, used only by server-side AI endpoints:
GEMINI_API_KEY=
# Optional: pin the Gemini text model (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
