# Copy to .env in the repository root. Never commit your .env.
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Use the public anon JWT or sb_publishable_ key, NEVER service_role / sb_secret_.

# Server-side language-model endpoints (Groq OpenAI-compatible API)
GROQ_API_KEY=
# Optional model overrides. Defaults: openai/gpt-oss-20b (still served on the Groq
# Free tier), fallback openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Optional: a model for the 1-Click mock generator only (default: GROQ_MODEL). Groq
# counts rate limits per model, so a separate one keeps long generator runs from
# using up the quota of grading and the AI Coach.
# GROQ_GENERATOR_MODEL=openai/gpt-oss-20b
