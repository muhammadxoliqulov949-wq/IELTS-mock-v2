# IELTS Mock — environment variables
# Copy this file to .env (for `vercel dev`) or add these in
# Vercel → Project → Settings → Environment Variables.

# Required for AI grading (Writing/Speaking), the AI Coach and the
# 1-Click AI Mock Generator. Get a free API key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. The Gemini model id every AI endpoint uses (default:
# gemini-3.8-flash, see lib/geminiModel.js). Set this when your key is pinned
# to a different model — e.g. GEMINI_MODEL=gemini-3.5-flash — so a Google
# rotation never needs a code change. GEMINI_TTS_MODELS does the same for the
# TTS fallback (comma-separated, default: gemini-3.8-flash-tts,
# gemini-3.8-flash-lite-tts).
GEMINI_MODEL=
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts

# Public Supabase settings. Also used by the generator when it uploads
# audio/images into the public "ielts-media" bucket.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Recommended for the 7-day AI cache (public.ai_cache, migration
# 202610060002_ai_cache.sql). That table grants nothing to browser roles,
# so only a server-side key can read and write it. Without it the cache
# silently no-ops and every AI request goes straight to Gemini.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
