# IELTS Mock — environment variables
# Copy this file to .env (for `vercel dev`) or add these in
# Vercel → Project → Settings → Environment Variables.

# Required for AI grading (Writing/Speaking), the AI Coach, the quiz
# generator and the 1-Click AI Mock Generator. Get a free API key at:
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional. The Groq text model every AI endpoint uses (default:
# llama-3.3-70b-versatile, see lib/aiClient.js). Groq retired that model for
# free/developer-tier keys on 2026-08-16, and in that case the client falls
# back to openai/gpt-oss-120b automatically and remembers the live model.
# Set this to pin another one, e.g. GROQ_MODEL=openai/gpt-oss-120b.
GROQ_MODEL=
# Optional. Orpheus voice for generated listening audio
# (autumn, diana, hannah, austin, daniel, troy).
# GROQ_TTS_VOICE=troy

# Public Supabase settings. Also used by the generator when it uploads
# audio/images into the public "ielts-media" bucket.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Recommended for the 7-day AI cache (public.ai_cache, migration
# 202610060002_ai_cache.sql). That table grants nothing to browser roles,
# so only a server-side key can read and write it. Without it the cache
# silently no-ops and every AI request goes straight to Groq.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
