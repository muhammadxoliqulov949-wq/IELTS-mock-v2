# IELTS Mock — environment variables
# Copy this file to .env (for `vercel dev`) or add these in
# Vercel → Project → Settings → Environment Variables.

# Required by server-side AI grading, the AI Coach, quizzes, and mock generation.
# Get a key at https://console.groq.com/keys. The key is used only on the server.
GROQ_API_KEY=your_groq_api_key_here

# Optional. The primary model (default openai/gpt-oss-20b, which Groq still serves
# on the Free tier) and the model used when Groq reports the primary as unavailable
# (default openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional. The model of the 1-Click mock generator only (default: GROQ_MODEL).
# Groq counts rate limits per model, so a separate model also keeps long
# generator runs from using up the quota of grading and the AI Coach.
# GROQ_GENERATOR_MODEL=openai/gpt-oss-20b

# Groq answers HTTP 429 when a Free-tier limit is reached. The server treats that
# as a pause, not a failure: it tries the other keys, then waits 2-3 s, 4-5 s,
# 8-9 s (longer if Groq's Retry-After says so) and sends the request again, up to
# 3 times. Nothing to configure.

# Public Supabase settings. Also used by the generator when it uploads
# audio/images into the public "ielts-media" bucket.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Recommended for the 7-day AI cache (public.ai_cache, migration
# 202610060002_ai_cache.sql). That table grants nothing to browser roles,
# so only a server-side key can read and write it. Without it the cache
# silently no-ops and requests go straight to Groq.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
